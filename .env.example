# Публичный адрес сайта (canonical, sitemap, Open Graph). Без завершающего слеша.
NEXT_PUBLIC_SITE_URL=https://example.ru
# production — разрешить индексацию. Любое другое значение (preview, staging) — noindex и Disallow в robots.txt.
NEXT_PUBLIC_SITE_ENV=preview

# Канал доставки заявок: telegram | webhook | test (test работает только вне production).
# Пусто — приём заявок выключен, сайт предлагает позвонить.
APPOINTMENT_DELIVERY=
# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# webhook (CRM, почтовый шлюз)
APPOINTMENT_WEBHOOK_URL=
APPOINTMENT_WEBHOOK_SECRET=
# Соль для хеширования IP в ограничителе частоты
RATE_LIMIT_SALT=

# Яндекс Метрика клиники (только номер счётчика). Пусто — аналитика не подключается.
NEXT_PUBLIC_YM_ID=

# Только для разработки:
# PRICES_FIXTURE=1      — показать демонстрационный прайс для проверки фильтров
# TEST_DELIVERY_FAIL=1  — имитировать сбой тестового адаптера доставки
