{
  "name": "enzoo-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:phone": "node --experimental-strip-types --no-warnings scripts/check-phone.ts",
    "telegram:chats": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local scripts/telegram-check.ts chats",
    "telegram:test": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local scripts/telegram-check.ts test"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "typescript": "^5.9.3"
  }
}
